# ESE repo auto-detection checks ../ESE first, then ./ESE, ~/ESE, and D:/ESE on Windows.
# Set this when your ESE repository lives somewhere else.
ESE_DIR=

# Taiko site base URL. Leave empty to use local taiko-web2 config or http://127.0.0.1/.
SITE_URL=http://127.0.0.1

# Uploaded songs state. Successful uploads are appended here.
STATE_FILE=uploaded2.json

# Git pull behavior. The default avoids merge commits in unattended runs.
GIT_PULL_ARGS=--ff-only
# Git pull has no timeout. Use this local Ubuntu SOCKS proxy for slow network pulls.
GIT_PROXY_URL=socks5h://127.0.0.1:40000

# Upload behavior. Song uploads are always direct and do not use a proxy.
AUDIO_EXTENSIONS=.ogg
UPLOAD_ATTEMPTS=3
RETRY_WAIT_SECONDS=10

# Resend email summary.
RESEND_API_KEY=
RESEND_FROM=ESE Updater <noreply@example.com>
RESEND_TO=user@example.com
EMAIL_SUBJECT_PREFIX=[ESE Update]
EMAIL_MAX_SONGS=200

# setup.sh uses these for the systemd timer.
UPDATE_ON_CALENDAR=*-*-* 04:00:00
RANDOMIZED_DELAY_SEC=0
